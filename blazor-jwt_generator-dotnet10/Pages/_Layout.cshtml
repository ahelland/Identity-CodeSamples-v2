@namespace blazor_jwt_generator_dotnet10.Pages

<!DOCTYPE html>
<html lang="en" data-bs-theme="dark" color-mode="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="~/" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" />
    <link href="css/site.css" rel="stylesheet" />
    <link href="blazor-jwt_generator-dotnet10.styles.css" rel="stylesheet" />
    <component type="typeof(HeadOutlet)" render-mode="ServerPrerendered" />
</head>
<body>
    @RenderBody()

    <div id="blazor-error-ui">
        <environment include="Staging,Production">
            An error has occurred. This application may no longer respond until reloaded.
        </environment>
        <environment include="Development">
            An unhandled exception has occurred. See browser dev tools for details.
        </environment>
        <a href="" class="reload">Reload</a>
        <a class="dismiss">🗙</a>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="_framework/blazor.server.js"></script>
    <script>
        (function () {
            function setTheme(mode) {
                document.documentElement.setAttribute('data-bs-theme', mode);
                document.documentElement.setAttribute('color-mode', mode);
                try { localStorage.setItem('color-mode', mode); } catch (e) { }
            }

            // Default to dark mode on first load.
            setTheme('dark');

        // Exposed for the theme-toggle button in the navigation menu.
        window.blazorToggleTheme = function () {
            var current = document.documentElement.getAttribute('color-mode') === 'dark' ? 'dark' : 'light';
            setTheme(current === 'dark' ? 'light' : 'dark');
        };

        // Exposed for the token generators so times can be stamped against the
        // client's clock instead of the server's. 'now' is ms since epoch,
        // 'offset' is minutes (UTC - local, i.e. new Date().getTimezoneOffset()).
        window.getBrowserTime = function () {
            return {
                now: Date.now(),
                offset: new Date().getTimezoneOffset()
            };
        };
    })();
    </script>
</body>
</html>
